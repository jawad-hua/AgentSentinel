# Server-only variables. NEVER prefix secrets with NEXT_PUBLIC_.
AGENTSENTINEL_API_URL=http://127.0.0.1:8000
ADMIN_API_TOKEN=
CONSOLE_ORIGIN=http://127.0.0.1:3000

# Optional for loopback, required with an HTTPS non-loopback CONSOLE_ORIGIN.
# Use a separate random password of at least 32 characters, never an API key.
CONSOLE_USERNAME=
CONSOLE_PASSWORD=
