DATABASE_URL=sqlite:///./data/agentsentinel.db
# Generate two DIFFERENT secrets with scripts/setup.py. Never use example values.
ADMIN_API_TOKEN=
INGEST_API_TOKEN=
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
HTTP_TIMEOUT_SECONDS=15
KILL_SWITCH=true

# Read-only inference controls.
ANALYSIS_ENABLED=true
ANALYSIS_AUTO_NEW=true
ANALYSIS_DAILY_LIMIT=20
GROQ_TIMEOUT_SECONDS=60

# Repairs stay disabled until explicitly configured. IDs are comma-separated.
REPAIRS_ENABLED=false
REPAIR_WORKFLOW_IDS=
N8N_WRITE_API_KEY=
# Generate once with scripts/setup_repairs.py; retain securely with DB backups.
SNAPSHOT_ENCRYPTION_KEY=

ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CHAOS_ENABLED=false
CHAOS_WORKFLOW_IDS=
